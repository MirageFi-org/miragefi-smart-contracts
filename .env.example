# Deployer key. On testnet this account is also the initial governance owner and attestation issuer.
PRIVATE_KEY=

# Robinhood Chain RPC endpoints (see https://docs.robinhood.com/chain/ for the official URLs)
ROBINHOOD_TESTNET_RPC=
ROBINHOOD_RPC=

# Blockscout verification
ROBINHOOD_TESTNET_BLOCKSCOUT_API=
ROBINHOOD_BLOCKSCOUT_API=
BLOCKSCOUT_API_KEY=unused

# Optional governance overrides
GOV=
GUARDIAN=
TIMELOCK_DELAY=3600
FINISH_BOOTSTRAP=false

# External dependencies. Leave blank on testnet to deploy mocks (DEPLOY_MOCKS defaults to true off mainnet).
USDG=
STOCK_TOKEN=
STOCK_FEED=
SEQUENCER_FEED=
MARKET_STATUS_SOURCE=
STREAM_ADAPTER=
ATTESTATION_ISSUER=
